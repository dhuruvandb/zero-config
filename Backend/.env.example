# Backend Environment Configuration Template
# Copy this file to .env and update with your actual values

# Node Environment (development, production, staging)
NODE_ENV=development

# Server Configuration
PORT=8000

# Security: CORS Origins (comma-separated, no trailing spaces)
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Level (error, warn, log, debug, verbose)
LOG_LEVEL=debug

# File Size Limits (in bytes)
MAX_ZIP_SIZE=52428800
MAX_EXTRACTED_SIZE=104857600

# Security Headers
X_FRAME_OPTIONS=DENY
CONTENT_SECURITY_POLICY=default-src 'self'
